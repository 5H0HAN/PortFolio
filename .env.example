# Canonical production origin used by metadata, JSON-LD, sitemap, and RSS.
NEXT_PUBLIC_SITE_URL=https://shohanbiswas.com

# Optional direct contact-form delivery through the Resend Email API.
# Without these values, the form safely falls back to opening an email draft.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Shohan Biswas Portfolio <portfolio@shohanbiswas.com>"
CONTACT_TO_EMAIL=hello@shohanbiswas.com

# Required on the deployed site for authenticated GitHub-backed editing.
# Local development uses Keystatic local mode and does not require these values.
# Set this to "github" locally only while creating or reconnecting the GitHub App.
NEXT_PUBLIC_KEYSTATIC_STORAGE_KIND=local
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
